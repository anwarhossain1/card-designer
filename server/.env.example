NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Required since accounts landed — users and sessions need persistence.
MONGODB_URI=mongodb://127.0.0.1:27017/card-designer

# Separate secrets, so a leaked access secret cannot mint refresh tokens.
# At least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=replace-me-with-at-least-32-random-characters
REFRESH_TOKEN_SECRET=replace-me-with-a-different-32-plus-random-string

# Optional; these are the defaults.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Where password-reset links point. The API never serves that page.
FRONTEND_URL=http://localhost:3000

# Required in production — the app refuses to start without them, because a
# reset link that cannot be delivered is a locked-out user. Leave them unset in
# development and emails are written to the server log instead of sent.
# For Gmail this is an app password, not the account password.
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=CardCraft
